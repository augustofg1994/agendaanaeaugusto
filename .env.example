# Copie este arquivo para .env e preencha com valores reais.
# .env nunca é commitado (veja .gitignore).

# Connection string do Postgres (Neon, Supabase, ou `npx prisma dev` localmente)
DATABASE_URL="postgresql://usuario:senha@host:5432/banco?sslmode=require"

# Gere com: openssl rand -base64 32
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# URL pública da aplicação (usada nos links dos e-mails de redefinição de senha)
APP_URL="http://localhost:3000"

# Resend (https://resend.com) — usado para o e-mail de "esqueci minha senha"
RESEND_API_KEY=""
EMAIL_FROM="Clínica <onboarding@resend.dev>"

# Usados apenas pelo prisma/seed.ts para criar as contas iniciais dos dois médicos/admin
SEED_DOCTOR1_NAME="Dr. Fulano"
SEED_DOCTOR1_EMAIL="fulano@example.com"
SEED_DOCTOR1_PASSWORD="troque-esta-senha"
SEED_DOCTOR2_NAME="Dra. Fulana"
SEED_DOCTOR2_EMAIL="fulana@example.com"
SEED_DOCTOR2_PASSWORD="troque-esta-senha"
